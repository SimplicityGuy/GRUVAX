# GRUVAX environment file — copy to `.env` and fill in real values.
#
# `docker compose up` reads `.env` automatically; pydantic-settings also
# reads it when running `uv run gruvax-*` outside Docker. NEVER commit `.env`.
#
# ──────────────────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────────────────
# SQLAlchemy / Alembic async form: postgresql+psycopg://user:pass@host/db
# Boot fails with a clear pydantic ValidationError if this is missing.
# gruvax-95qp: DATABASE_URL is env-first — compose.yaml uses this value
# verbatim when set, and only falls back to assembling one from the
# GRUVAX_DB_* pieces below when DATABASE_URL itself is absent. Point this at
# the shared discogsography Postgres for a real deployment.
DATABASE_URL=postgresql+psycopg://gruvax:gruvax@gruvax-dev-pg:5432/gruvax

# Alternative to DATABASE_URL above: leave DATABASE_URL unset/commented and
# override these pieces instead (compose assembles DATABASE_URL from them).
# Ignored whenever DATABASE_URL is set.
# GRUVAX_DB_USER=gruvax
# GRUVAX_DB_PASSWORD=gruvax
# GRUVAX_DB_HOST=gruvax-dev-pg
# GRUVAX_DB_PORT=5432
# GRUVAX_DB_NAME=gruvax

# ──────────────────────────────────────────────────────────────────────────
# Admin session signing (SESSION_SECRET — Plan 03)
# ──────────────────────────────────────────────────────────────────────────
# Signs the admin session cookie. Boot fails if missing.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=replace-me-with-a-real-32-byte-urlsafe-token

# ──────────────────────────────────────────────────────────────────────────
# discogsography integration (Plan 01-01 / D-18)
# ──────────────────────────────────────────────────────────────────────────
# The HTTP API base URL of the discogsography service. Prod points at the
# real discogsography-api; dev compose defaults to the in-stack
# fake-discogsography sibling service. Boot fails if missing.
DISCOGSOGRAPHY_BASE_URL=http://fake-discogsography:8004

# ──────────────────────────────────────────────────────────────────────────
# Fernet key for PAT-at-rest encryption (Plan 01-01 / D-01)
# ──────────────────────────────────────────────────────────────────────────
# URL-safe base64-encoded 32 random bytes. Boot fails if missing or
# malformed (a Fernet validator runs in gruvax.settings on every startup).
# Generate ONCE per deployment and persist:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating the key orphans every existing profiles.app_token_encrypted row;
# a P4 utility will land for the re-encrypt flow. For now, treat as a
# permanent per-deployment value.
GRUVAX_SECRET_KEY=replace-me-with-Fernet.generate_key().decode()

# ──────────────────────────────────────────────────────────────────────────
# MQTT (Mosquitto sidecar — Phase 6+ hardware milestone)
# ──────────────────────────────────────────────────────────────────────────
# Defaults work for `docker compose up`; override only when running outside
# the stack or against a remote broker.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=gruvax-api
MQTT_PASSWORD=

# ──────────────────────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ──────────────────────────────────────────────────────────────────────────
# Environment selector (Plan 01-06 / Plan 01-10)
# ──────────────────────────────────────────────────────────────────────────
# Controls dev-only behaviors in docker-entrypoint.sh:
#   1. Bootstraps empty `gruvax_dev.{collection_items, releases, artists}`
#      stub tables before `alembic upgrade head` (lets migration 0002's
#      `CREATE VIEW gruvax.v_collection` succeed against a fresh
#      `postgres:18` that has no real discogsography schema).
#   2. Seeds `gruvax.profile_collection` with ~3,000 SYNTHETIC records after
#      migrations run (Plan 01-06) — and, because compose.yaml's init-sync
#      idempotency precheck (D-16) sees the collection already populated, this
#      PERMANENTLY skips the real Discogs sync on every subsequent boot too.
#
# gruvax-b51h: this MUST stay unset/commented-out here. Shipping it set to
# `development` meant `cp .env.example .env` on a production host (the exact
# step 2 of docs/runbook-fresh-host.md) silently seeded synthetic data into
# the real collection and never synced for real — with the runbook's own
# "expected output" treating the resulting skip as healthy. See
# docs/runbook-fresh-host.md's "GRUVAX_ENV" pre-flight check before deploying.
#
# Uncomment ONLY for local dev / CI / `just compose-smoke` (the compose
# default `${GRUVAX_ENV:-production}` otherwise resolves to `production` and
# correctly skips both dev-only steps):
# GRUVAX_ENV=development
